FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-langgraph.txt /app/requirements-langgraph.txt
RUN pip install --no-cache-dir -r /app/requirements-langgraph.txt

COPY lara_langgraph /app/lara_langgraph

EXPOSE 8080

CMD ["uvicorn", "lara_langgraph.service:app", "--host", "0.0.0.0", "--port", "8080"]
